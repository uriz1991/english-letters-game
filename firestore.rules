rules_version = '2';
// Each parent (Google account) can read and write only their own children. Everything else is closed.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /parents/{uid}/kids/{kid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && kid.matches('^[a-z0-9]{4,20}$')
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'g', 'progress', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16
        && request.resource.data.g in ['m', 'f']
        && request.resource.data.progress is string && request.resource.data.progress.size() <= 300000
        && request.resource.data.updated is int;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
